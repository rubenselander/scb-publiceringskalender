</div>

<div class="row">
    <div class="columns nine">
        <h2>Unders&#xF6;kningar indelade efter statistikomr&#xE5;de</h2>
    </div>
    <div class="columns three">
        <button id="collapse-all" class="link-button float-right collapse-marg10">St&#xE4;ng alla</button>
        <button id="expand-all" class="link-button float-right">&#xD6;ppna alla</button>
